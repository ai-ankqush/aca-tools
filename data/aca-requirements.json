      "applies_to": "uses internal enterprise data or vendor AI for productivity, without influencing decisions or taking actions"
    },
    "T3": {
      "name": "Decision-supporting AI",
      "applies_to": "influences human decisions, judgments, or records (classify, rank, score, summarize, recommend)"
    },
    "T4": {
