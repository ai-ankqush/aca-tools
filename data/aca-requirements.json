  "requirements": [
    {
      "id": "ACA-07-01",
      "pillar": "07",
      "statement": "The organization SHALL maintain an inventory of all AI use cases, including embedded and vendor AI.",
      "normative_keyword": "SHALL",
      "from_tier": "T1",
      "applies_to_tiers": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Evidenced"
    },
    {
      "id": "ACA-07-02",
      "pillar": "07",
      "statement": "Each use case SHALL have a named accountable owner recorded at intake.",
      "normative_keyword": "SHALL",
      "from_tier": "T1",
      "applies_to_tiers": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Declared"
    },
    {
      "id": "ACA-07-03",
      "pillar": "07",
      "statement": "Each use case SHALL be assigned a risk tier before controls are selected.",
      "normative_keyword": "SHALL",
      "from_tier": "T1",
      "applies_to_tiers": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Evidenced"
    },
    {
      "id": "ACA-07-04",
      "pillar": "07",
      "statement": "The inventory SHALL be reconciled on a defined cadence and on material change.",
      "normative_keyword": "SHALL",
      "from_tier": "T2",
      "applies_to_tiers": [
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Evidenced"
    },
    {
      "id": "ACA-08-01",
      "pillar": "08",
      "statement": "AI SHALL act under a distinct non-human identity, not a user's standing credentials.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-08-02",
      "pillar": "08",
      "statement": "AI identities SHALL be granted least-privilege access scoped to the use case.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-08-03",
      "pillar": "08",
      "statement": "AI access SHALL be revocable promptly and completely.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-08-04",
      "pillar": "08",
      "statement": "Consequential actions SHALL be attributable to the identity and grant that authorized them.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
      "boundary": "Enforced"
    },
    {
      "id": "ACA-09-01",
      "pillar": "09",
      "statement": "The data sources an AI may access SHALL be explicitly defined and approved.",
      "normative_keyword": "SHALL",
      "from_tier": "T2",
      "applies_to_tiers": [
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Evidenced"
    },
    {
      "id": "ACA-09-02",
      "pillar": "09",
      "statement": "Retrieval SHALL be scoped so AI cannot surface data the requester is not entitled to.",
      "normative_keyword": "SHALL",
      "from_tier": "T2",
      "applies_to_tiers": [
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-09-03",
      "pillar": "09",
      "statement": "Sensitive data classes SHALL be excluded or masked unless explicitly permitted.",
      "normative_keyword": "SHALL",
      "from_tier": "T2",
      "applies_to_tiers": [
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-09-04",
      "pillar": "09",
      "statement": "Third-party processing and retention of data SHALL be known and bounded.",
      "normative_keyword": "SHALL",
      "from_tier": "T2",
      "applies_to_tiers": [
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Evidenced"
    },
    {
      "id": "ACA-10-01",
      "pillar": "10",
      "statement": "Untrusted input, including retrieved content, SHALL be treated as potentially adversarial.",
      "normative_keyword": "SHALL",
      "from_tier": "T3",
      "applies_to_tiers": [
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Evidenced"
    },
    {
      "id": "ACA-10-02",
      "pillar": "10",
      "statement": "Prompt-injection and manipulation SHALL be mitigated proportionate to tier.",
      "normative_keyword": "SHALL",
      "from_tier": "T3",
      "applies_to_tiers": [
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-10-03",
      "pillar": "10",
      "statement": "System instructions SHALL be protected from override by user or retrieved content.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
      "boundary": "Enforced"
    },
    {
      "id": "ACA-11-01",
      "pillar": "11",
      "statement": "Output that influences a consequential decision SHALL be identified as such.",
      "normative_keyword": "SHALL",
      "from_tier": "T3",
      "applies_to_tiers": [
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Evidenced"
    },
    {
      "id": "ACA-11-02",
      "pillar": "11",
      "statement": "High-impact decisions SHALL require human validation before effect.",
      "normative_keyword": "SHALL",
      "from_tier": "T3",
      "applies_to_tiers": [
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Enforced"
    },
    {
      "id": "ACA-11-03",
      "pillar": "11",
      "statement": "AI-influenced decisions SHALL be recorded with the output and rationale.",
      "normative_keyword": "SHALL",
      "from_tier": "T3",
      "applies_to_tiers": [
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Evidenced"
    },
    {
      "id": "ACA-12-01",
      "pillar": "12",
      "statement": "The tools and actions an AI may invoke SHALL be explicitly allow-listed.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-12-02",
      "pillar": "12",
      "statement": "High-impact actions SHALL require approval or step-up before execution.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
      "boundary": "Enforced"
    },
    {
      "id": "ACA-12-03",
      "pillar": "12",
      "statement": "No action class SHALL be enforced live without a defined containment or compensation path.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
      "boundary": "Enforced"
    },
    {
      "id": "ACA-12-04",
      "pillar": "12",
      "statement": "Every action SHALL be logged with the requesting identity, inputs, and outcome.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-13-01",
      "pillar": "13",
      "statement": "A named human SHALL own each consequential outcome, decision, approval, and exception.",
      "normative_keyword": "SHALL",
      "from_tier": "T1",
      "applies_to_tiers": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Declared"
    },
    {
      "id": "ACA-13-02",
      "pillar": "13",
      "statement": "Risk acceptance for a use case SHALL be recorded and attributable.",
      "normative_keyword": "SHALL",
      "from_tier": "T3",
      "applies_to_tiers": [
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Evidenced"
    },
    {
      "id": "ACA-13-03",
      "pillar": "13",
      "statement": "Recovery ownership SHALL be assigned before go-live for action-capable use cases.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
      "boundary": "Declared"
    },
    {
      "id": "ACA-14-01",
      "pillar": "14",
      "statement": "Controls SHALL be tested before go-live, proportionate to tier.",
      "normative_keyword": "SHALL",
      "from_tier": "T3",
      "applies_to_tiers": [
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-14-02",
      "pillar": "14",
      "statement": "High-impact and autonomous use cases SHALL undergo adversarial testing of input, output, and action controls.",
      "normative_keyword": "SHALL",
      "from_tier": "T5",
      "applies_to_tiers": [
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-14-03",
      "pillar": "14",
      "statement": "Test results SHALL be retained as evidence and re-run on material change.",
      "normative_keyword": "SHALL",
      "from_tier": "T3",
      "applies_to_tiers": [
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-15-01",
      "pillar": "15",
      "statement": "Activity SHALL be logged sufficiently to reconstruct what AI saw, produced, decided, and did.",
      "normative_keyword": "SHALL",
      "from_tier": "T2",
      "applies_to_tiers": [
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-15-02",
      "pillar": "15",
      "statement": "Logs SHALL be tamper-evident and retained per policy.",
      "normative_keyword": "SHALL",
      "from_tier": "T3",
      "applies_to_tiers": [
        "T3",
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-15-03",
      "pillar": "15",
      "statement": "Anomalous or policy-violating behavior SHALL be detectable and alertable.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
      "boundary": "Verified"
    },
    {
      "id": "ACA-16-01",
      "pillar": "16",
      "statement": "Each tiered use case SHALL have a tested means to disable the AI capability quickly.",
      "normative_keyword": "SHALL",
      "from_tier": "T4",
      "applies_to_tiers": [
        "T4",
        "T5"
      ],
